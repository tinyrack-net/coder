{
  "_comment": [
    "Full matrices used by the merge queue, tags, and manual dispatch.",
    "Pull requests use the separate Linux fast gate and do not consume these.",
    "They live here so `cli-verify` and `mobile-debug-build` each keep one job",
    "body, and so the release job's target list can be compared against them."
  ],
  "cli": [
    { "os": "ubuntu-24.04", "target": "linux-x64", "platform": "linux" },
    {
      "os": "macos-26",
      "target": "macos-x64",
      "platform": "macos",
      "sdk_arch": "x64"
    },
    { "os": "macos-26", "target": "macos-arm64", "platform": "macos" },
    { "os": "windows-2025", "target": "windows-x64", "platform": "windows" }
  ],
  "mobile": [
    {
      "os": "ubuntu-24.04",
      "gradle_cache": true,
      "command": "flutter build apk --debug -t lib/main_mobile.dart"
    },
    {
      "os": "macos-26",
      "gradle_cache": false,
      "command": "flutter build ios --debug --no-codesign -t lib/main_mobile.dart -v"
    }
  ]
}
